---
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title sl-flex" translate="no">
	<span class="mark" aria-hidden="true">
		<svg width="14" height="14" viewBox="0 0 24 24" fill="none">
			<circle cx="7" cy="7" r="2.2" fill="#fff" />
			<circle cx="17" cy="7" r="2.2" fill="#fff" />
			<circle cx="7" cy="17" r="2.2" fill="#fff" />
			<circle cx="17" cy="17" r="2.2" fill="#fff" />
		</svg>
	</span>
	<span class="wordmark">{siteTitle}</span>
</a>

<style>
	.site-title {
		align-items: center;
		gap: 0.625rem;
		text-decoration: none;
		white-space: nowrap;
		min-width: 0;
	}

	.mark {
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		width: 1.75rem;
		height: 1.75rem;
		border-radius: 0.5rem;
		background: var(--grad);
		box-shadow: 0 2px 12px color-mix(in srgb, var(--brand-1) 45%, transparent);
	}

	.wordmark {
		font-family: var(--display);
		font-weight: 600;
		font-size: 1.0625rem;
		letter-spacing: -0.01em;
		color: var(--sl-color-white);
		overflow: hidden;
		text-overflow: ellipsis;
	}
</style>
