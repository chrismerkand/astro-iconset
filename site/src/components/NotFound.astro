---
import { Icon } from "astro-iconset/components";

// Decorative floating tiles (desktop gutters). Navigation-themed to echo the
// "lost / find your way back" idea. Hidden below 64rem where gutters collapse.
const tiles = [
  {
    pos: "top:18%;left:6%",
    rot: "-8deg",
    dur: "7s",
    delay: "0s",
    size: "3rem",
    kind: "plain",
    accent: true,
    icon: "lucide:map",
  },
  {
    pos: "top:62%;left:9%",
    rot: "6deg",
    dur: "8.5s",
    delay: "0.8s",
    size: "2.5rem",
    kind: "grad",
    icon: "lucide:navigation",
  },
  {
    pos: "top:40%;left:3%",
    rot: "4deg",
    dur: "9s",
    delay: "1.6s",
    size: "2.5rem",
    kind: "plain",
    dim: true,
    icon: "lucide:signpost",
  },
  {
    pos: "top:16%;right:7%",
    rot: "7deg",
    dur: "7.5s",
    delay: "0.4s",
    size: "2.5rem",
    kind: "plain",
    dim: true,
    icon: "lucide:route",
  },
  {
    pos: "top:52%;right:4%",
    rot: "-6deg",
    dur: "8s",
    delay: "1.2s",
    size: "3rem",
    kind: "plain",
    accent: true,
    icon: "lucide:map-pin",
  },
  {
    pos: "top:74%;right:9%",
    rot: "5deg",
    dur: "9.5s",
    delay: "2s",
    size: "2.5rem",
    kind: "grad2",
    icon: "lucide:search",
  },
];

// Corner variant for <64rem, where the side gutters no longer exist.
const mobileTiles = [
  {
    pos: "top:1rem;left:5%",
    rot: "-8deg",
    dur: "7s",
    delay: "0s",
    size: "2.1rem",
    kind: "plain",
    accent: true,
    icon: "lucide:map",
  },
  {
    pos: "top:1.4rem;right:6%",
    rot: "7deg",
    dur: "8s",
    delay: "0.5s",
    size: "1.8rem",
    kind: "grad",
    icon: "lucide:navigation",
  },
  {
    pos: "bottom:1.2rem;left:6%",
    rot: "5deg",
    dur: "8.6s",
    delay: "1s",
    size: "1.8rem",
    kind: "plain",
    dim: true,
    icon: "lucide:signpost",
  },
  {
    pos: "bottom:1rem;right:5%",
    rot: "-6deg",
    dur: "9.2s",
    delay: "1.5s",
    size: "2.1rem",
    kind: "grad2",
    icon: "lucide:search",
  },
];
---

<div class="landing">
  <section class="nf">
    <div class="dots" aria-hidden="true"></div>
    <div class="glow" aria-hidden="true"></div>

    <div class="tiles" aria-hidden="true">
      {
        tiles.map((t) => (
          <span
            class:list={[
              "tile",
              `tile-${t.kind}`,
              { accent: t.accent, dim: t.dim },
            ]}
            style={`${t.pos};--rot:${t.rot};--dur:${t.dur};--delay:${t.delay};width:${t.size};height:${t.size}`}
          >
            <Icon name={t.icon} is:inline width="58%" height="58%" />
          </span>
        ))
      }
    </div>

    <div class="tiles-mobile" aria-hidden="true">
      {
        mobileTiles.map((t) => (
          <span
            class:list={[
              "tile",
              `tile-${t.kind}`,
              { accent: t.accent, dim: t.dim },
            ]}
            style={`${t.pos};--rot:${t.rot};--dur:${t.dur};--delay:${t.delay};width:${t.size};height:${t.size}`}
          >
            <Icon name={t.icon} is:inline width="58%" height="58%" />
          </span>
        ))
      }
    </div>

    <div class="nf-inner">
      <div class="code" role="img" aria-label="404 — page not found">
        <span class="dig">4</span>
        <span class="zero">
          <Icon name="lucide:compass" is:inline width="62%" height="62%" />
        </span>
        <span class="dig">4</span>
      </div>

      <h1>That page isn’t in the set.</h1>
      <p class="lead">
        The link may be broken, or the page may have moved. Search the docs, or
        head back to solid ground.
      </p>

      <div class="actions">
        <a class="cta" href="/">
          <Icon name="lucide:arrow-left" is:inline width="15" height="15" />
          Back to home
        </a>
        <a class="ghost" href="/getting-started/">
          Getting started
          <Icon name="lucide:arrow-right" is:inline width="15" height="15" />
        </a>
      </div>

      <p class="hint">
        Press <kbd>Ctrl</kbd><kbd>K</kbd> to search the docs
      </p>
    </div>
  </section>
</div>

<style>
  .landing {
    width: 100%;
  }

  .nf {
    --ac1: #10b981;
    --ac2: #a3e635;
    --disp: "Space Grotesk Variable", var(--sl-font);
    --mono: "IBM Plex Mono", ui-monospace, monospace;
    --surface: #12151f;
    --line: rgba(160, 174, 208, 0.15);
    --text: #9aa3ba;
    --head: #f4f6fc;
    --dim: #5d6579;
    --tile-bg: #141827;
    --glow-op: 0.5;
    --dot: rgba(160, 174, 208, 0.28);
    --chip: rgba(160, 174, 208, 0.09);

    position: relative;
    overflow: hidden;
    display: grid;
    place-items: center;
    min-height: clamp(30rem, 76vh, 46rem);
    text-align: center;
    color: var(--text);
  }

  :global(:root[data-theme="light"]) .nf {
    --surface: #ffffff;
    --line: rgba(20, 30, 70, 0.14);
    --text: #4b5468;
    --head: #0d1220;
    --dim: #8a92a6;
    --tile-bg: #ffffff;
    --glow-op: 0.28;
    --dot: rgba(20, 30, 70, 0.2);
    --chip: rgba(20, 30, 70, 0.05);
  }

  .nf :global(a) {
    text-decoration: none;
  }

  /* Ambient background — dot grid faded top & bottom, plus one accent glow. */
  .dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, var(--dot) 1px, transparent 1px);
    background-size: 26px 26px;
    -webkit-mask-image: radial-gradient(
      ellipse 70% 60% at 50% 45%,
      black 30%,
      transparent 78%
    );
    mask-image: radial-gradient(
      ellipse 70% 60% at 50% 45%,
      black 30%,
      transparent 78%
    );
    pointer-events: none;
  }
  .glow {
    position: absolute;
    top: -16rem;
    left: 50%;
    width: 52rem;
    height: 30rem;
    transform: translateX(-50%);
    opacity: var(--glow-op);
    pointer-events: none;
    background: radial-gradient(
      ellipse at center,
      color-mix(in srgb, var(--ac1) 40%, transparent),
      transparent 68%
    );
  }

  /* Floating tiles — same material as the landing hero. */
  .tiles,
  .tiles-mobile {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .tiles-mobile {
    display: none;
  }
  .tile {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.875rem;
    border: 1px solid var(--line);
    background: var(--tile-bg);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
    color: var(--text);
    opacity: 0.7;
    animation: float var(--dur, 8s) ease-in-out var(--delay, 0s) infinite;
  }
  .tile.accent {
    color: color-mix(in oklab, var(--ac1) 60%, var(--ac2));
    opacity: 1;
  }
  .tile.dim {
    opacity: 0.6;
  }
  .tile-grad {
    background: linear-gradient(135deg, var(--ac1), var(--ac2));
    border-color: transparent;
    color: #fff;
    box-shadow: 0 8px 24px color-mix(in srgb, var(--ac1) 40%, transparent);
    opacity: 0.9;
  }
  .tile-grad2 {
    background: linear-gradient(135deg, var(--ac2), var(--ac1));
    border-color: transparent;
    color: #06240f;
    box-shadow: 0 8px 24px color-mix(in srgb, var(--ac2) 40%, transparent);
    opacity: 0.88;
  }
  @media (max-width: 64rem) {
    .tiles {
      display: none;
    }
    .tiles-mobile {
      display: block;
    }
  }

  /* Composition */
  .nf-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    padding: clamp(3rem, 8vh, 5rem) 1.5rem;
    max-width: 40rem;
  }

  /* 4 ⦿ 4 — the middle zero is a gradient icon tile (brand mark echo). */
  .code {
    display: flex;
    align-items: center;
    gap: clamp(0.5rem, 2vw, 1rem);
    animation: rise 0.5s ease both;
  }
  .dig {
    font-family: var(--disp);
    font-size: clamp(4.5rem, 17vw, 8rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--head);
  }
  .zero {
    display: grid;
    place-items: center;
    width: clamp(3.6rem, 14vw, 6.6rem);
    height: clamp(3.6rem, 14vw, 6.6rem);
    border-radius: clamp(1rem, 3.5vw, 1.75rem);
    background: linear-gradient(135deg, var(--ac1), var(--ac2));
    color: #06240f;
    box-shadow: 0 12px 40px color-mix(in srgb, var(--ac1) 45%, transparent);
    animation:
      rise 0.5s ease 0.05s both,
      bob 6s ease-in-out 0.5s infinite;
  }

  h1 {
    font-family: var(--disp);
    font-size: clamp(1.6rem, 4.5vw, 2.4rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--head);
    text-wrap: balance;
    margin: 0;
    animation: rise 0.5s ease 0.1s both;
  }
  .lead {
    font-size: 1.0625rem;
    line-height: 1.65;
    max-width: 34ch;
    color: var(--text);
    margin: 0;
    text-wrap: pretty;
    animation: rise 0.5s ease 0.16s both;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    justify-content: center;
    margin-top: 0.25rem;
    animation: rise 0.5s ease 0.22s both;
  }
  .cta,
  .ghost {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--disp);
    font-weight: 600;
    font-size: 0.9375rem;
    padding: 0.75rem 1.375rem;
    border-radius: 0.75rem;
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease,
      border-color 0.15s ease;
  }
  .cta {
    background: linear-gradient(135deg, var(--ac1), var(--ac2));
    color: #06240f !important;
    box-shadow: 0 4px 24px color-mix(in srgb, var(--ac1) 45%, transparent);
  }
  .cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 32px color-mix(in srgb, var(--ac1) 60%, transparent);
  }
  .ghost {
    color: var(--head) !important;
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .ghost:hover {
    border-color: color-mix(in srgb, var(--ac1) 50%, var(--line));
    transform: translateY(-2px);
  }

  .hint {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--dim);
    margin: 0.5rem 0 0;
    animation: rise 0.5s ease 0.28s both;
  }
  .hint kbd {
    font-family: var(--mono);
    font-size: 0.6875rem;
    color: var(--text);
    background: var(--chip);
    border: 1px solid var(--line);
    border-radius: 0.375rem;
    padding: 0.125rem 0.375rem;
    margin: 0 0.0625rem;
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0) rotate(var(--rot, 0deg));
    }
    50% {
      transform: translateY(-10px) rotate(var(--rot, 0deg));
    }
  }
  @keyframes bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tile,
    .zero,
    .code,
    h1,
    .lead,
    .actions,
    .hint {
      animation: none;
    }
  }
</style>
