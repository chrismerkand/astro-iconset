---
import { Icon } from 'astro-iconset/components';

const features = [
	{
		title: 'Local SVG files',
		desc: 'Drop .svg files in src/icons/ and reference them by name. Subfolders work — logos/astro for src/icons/logos/astro.svg.',
		icon: 'lucide:file',
		href: '/features/#local-svg-files',
	},
	{
		title: 'Iconify icon sets',
		desc: 'Install @iconify-json/* packages and use set:icon-name in name — 300,000+ icons across 214+ icon sets.',
		icon: 'lucide:puzzle',
		href: '/features/#iconify-icon-sets',
	},
	{
		title: 'Framework islands',
		desc: 'astro-iconset/react, /vue, /svelte, /preact, and /solid for icons inside framework components, not only .astro files.',
		icon: 'lucide:blocks',
		href: '/guides/frameworks/',
	},
	{
		title: 'SVG imports (?icon)',
		desc: 'Use import logo from "../assets/logo.svg?icon" and pass icon={logo} for files that shouldn\'t live in a shared icon dir.',
		icon: 'lucide:file-down',
		href: '/guides/icon-imports/',
	},
	{
		title: 'Sprites',
		desc: 'Repeated uses of the same icon share <symbol> / <use> output automatically — smaller HTML on icon-heavy pages.',
		icon: 'lucide:copy',
		href: '/features/#sprites',
	},
	{
		title: 'SVGO optimization',
		desc: 'Local SVGs pass through SVGO at build time; tune behavior with svgoOptions in config.',
		icon: 'lucide:badge-check',
		href: '/reference/configuration/#svgooptions',
	},
	{
		title: 'Named icon directories',
		desc: 'iconDirs maps prefixes to folders — e.g. brand:logo from src/brand-icons/. Mix multiple sets without collisions.',
		icon: 'lucide:folder',
		href: '/reference/configuration/#icondirs',
	},
	{
		title: 'SSR bundle control',
		desc: 'For server or hybrid output, include limits which Iconify icons ship in server bundles so you don\'t pull in whole sets.',
		icon: 'lucide:server',
		href: '/guides/deployment/',
	},
];

// Decorative floating tiles: [top, side, sideVal, rot, dur, delay, size, kind]
// Positioned within the outer gutters only (left/right <= 8%) so they never
// overlap the centered copy; the whole layer is hidden below 78rem.
const tiles = [
	{ pos: 'top:16%;left:5%', rot: '-8deg', dur: '7s', delay: '0s', size: '3.25rem', kind: 'plain', accent: true, icon: 'lucide:zap' },
	{ pos: 'top:60%;left:7%', rot: '6deg', dur: '8.5s', delay: '0.8s', size: '2.5rem', kind: 'grad', icon: 'lucide:heart' },
	{ pos: 'top:34%;left:2%', rot: '4deg', dur: '9s', delay: '1.6s', size: '2.75rem', kind: 'plain', dim: true, icon: 'lucide:star' },
	{ pos: 'top:14%;right:6%', rot: '7deg', dur: '7.5s', delay: '0.4s', size: '2.75rem', kind: 'plain', dim: true, icon: 'lucide:bell' },
	{ pos: 'top:46%;right:3%', rot: '-6deg', dur: '8s', delay: '1.2s', size: '3.25rem', kind: 'plain', accent: true, icon: 'lucide:globe' },
	{ pos: 'top:70%;right:7%', rot: '5deg', dur: '9.5s', delay: '2s', size: '2.5rem', kind: 'grad2', icon: 'lucide:check' },
	{ pos: 'top:80%;left:4%', rot: '-5deg', dur: '8.2s', delay: '0.6s', size: '2.25rem', kind: 'plain', dim: true, icon: 'lucide:moon' },
	{ pos: 'top:24%;right:2%', rot: '-4deg', dur: '8.8s', delay: '1.8s', size: '2.25rem', kind: 'plain', dim: true, icon: 'lucide:house' },
];

const mobileTiles = [
	{ pos: 'top:1rem;left:5%', rot: '-8deg', dur: '7s', delay: '0s', size: '2.25rem', kind: 'plain', accent: true, icon: 'lucide:zap' },
	{ pos: 'top:1.5rem;right:6%', rot: '7deg', dur: '8s', delay: '0.5s', size: '1.9rem', kind: 'grad', icon: 'lucide:heart' },
	{ pos: 'bottom:1.25rem;left:6%', rot: '5deg', dur: '8.6s', delay: '1s', size: '1.9rem', kind: 'plain', dim: true, icon: 'lucide:star' },
	{ pos: 'bottom:1rem;right:5%', rot: '-6deg', dur: '9.2s', delay: '1.5s', size: '2.25rem', kind: 'grad2', icon: 'lucide:globe' },
];
---

<div class="landing">
	<!-- Hero -->
	<section class="hero">
		<div class="dots" aria-hidden="true"></div>
		<div class="glow glow1" aria-hidden="true"></div>
		<div class="glow glow2" aria-hidden="true"></div>

		<div class="tiles" aria-hidden="true">
			{
				tiles.map((t) => (
					<span
						class:list={['tile', `tile-${t.kind}`, { accent: t.accent, dim: t.dim }]}
						style={`${t.pos};--rot:${t.rot};--dur:${t.dur};--delay:${t.delay};width:${t.size};height:${t.size}`}
					>
						<Icon name={t.icon} is:inline width="60%" height="60%" />
					</span>
				))
			}
		</div>

		<div class="tiles-mobile" aria-hidden="true">
			{
				mobileTiles.map((t) => (
					<span
						class:list={['tile', `tile-${t.kind}`, { accent: t.accent, dim: t.dim }]}
						style={`${t.pos};--rot:${t.rot};--dur:${t.dur};--delay:${t.delay};width:${t.size};height:${t.size}`}
					>
						<Icon name={t.icon} is:inline width="60%" height="60%" />
					</span>
				))
			}
		</div>

		<div class="hero-copy">
			<span class="eyebrow">
				<span class="eyebrow-dot"></span>
				Icon integration for Astro
			</span>
			<h1>Every icon you need.<br /><span class="grad-text">Zero runtime.</span></h1>
			<p class="lead">
				Local SVGs, 300,000+ Iconify icons, sprites, and framework adapters — resolved and
				optimized at build time. Nothing shipped to the browser.
			</p>
			<div class="actions">
				<a class="cta" href="/getting-started/">
					Get started
					<Icon name="lucide:arrow-right" is:inline width="15" height="15" />
				</a>
				<button class="copy-btn" type="button" data-copy="npx astro add astro-iconset" aria-label="Copy install command">
					<span class="prompt">$</span>
					<span class="cmd-label">npx astro add astro-iconset</span>
					<span class="copy-swap">
						<Icon name="lucide:copy" is:inline width="14" height="14" />
						<Icon name="lucide:check" is:inline width="14" height="14" />
					</span>
					<span class="copied-toast" aria-hidden="true">Copied!</span>
				</button>
			</div>
			<div class="stats">
				<div class="stat"><span class="stat-n">300k+</span><span class="stat-l">Iconify icons</span></div>
				<div class="stat"><span class="stat-n">5</span><span class="stat-l">framework adapters</span></div>
				<div class="stat"><span class="stat-n">0 kb</span><span class="stat-l">client JavaScript</span></div>
				<div class="stat"><span class="stat-n">100%</span><span class="stat-l">build-time SVGO</span></div>
			</div>
		</div>
	</section>

	<!-- 01 — What you get -->
	<section class="block features">
		<div class="block-head">
			<span class="kicker">01 — What you get</span>
			<h2>One component, every icon source</h2>
			<p>
				Icons are resolved, deduplicated, and optimized when you build — not loaded from a
				client-side icon pack. <a href="/features/">Features</a> has examples, comparisons, and deep
				dives.
			</p>
		</div>
		<div class="feature-grid">
			{
				features.map((f) => (
					<a class="card" href={f.href}>
						<span class="card-icon">
							<Icon name={f.icon} is:inline width="20" height="20" />
						</span>
						<h3 class="card-title">{f.title}</h3>
						<p class="card-desc">{f.desc}</p>
					</a>
				))
			}
		</div>
	</section>

	<!-- 02 — How it feels -->
	<section class="block teaser">
		<div class="teaser-copy">
			<span class="kicker">02 — How it feels</span>
			<h2>Name it, ship it</h2>
			<p>
				Reference a local file, an Iconify icon, or an imported SVG with the same
				<code>Icon</code> component. Repeated icons become sprites automatically.
			</p>
			<div class="teaser-links">
				<a href="/getting-started/">Getting started →</a>
				<a href="/reference/configuration/">Configuration →</a>
			</div>
		</div>
		<figure class="code-card">
			<figcaption>
				<span class="tl tl-r"></span>
				<span class="tl tl-y"></span>
				<span class="tl tl-g"></span>
				<span class="filename">src/pages/index.astro</span>
			</figcaption><pre><code><span class="cm">---</span>
<span class="kw">import</span> {'{'} Icon {'}'} <span class="kw">from</span> <span class="str">"astro-iconset/components"</span>;
<span class="kw">import</span> logo <span class="kw">from</span> <span class="str">"../assets/logo.svg?icon"</span>;
<span class="cm">---</span>

<span class="cm">{'<!-- src/icons/rocket.svg -->'}</span>
<span class="tag">{'<Icon'}</span> <span class="const">name</span>=<span class="str">"rocket"</span> <span class="tag">{'/>'}</span>

<span class="cm">{'<!-- any Iconify set -->'}</span>
<span class="tag">{'<Icon'}</span> <span class="const">name</span>=<span class="str">"mdi:account"</span> <span class="const">size</span>={'{'}<span class="const">24</span>{'}'} <span class="tag">{'/>'}</span>

<span class="cm">{'<!-- one-off import -->'}</span>
<span class="tag">{'<Icon'}</span> <span class="const">icon</span>={'{'}logo{'}'} <span class="const">title</span>=<span class="str">"Logo"</span> <span class="tag">{'/>'}</span></code></pre></figure>
	</section>
</div>

<style>
	/* Design tokens (dark) scoped to the landing */
	.landing {
		--ac1: #10b981;
		--ac2: #a3e635;
		--link: color-mix(in oklab, var(--ac1) 55%, var(--ac2));
		--disp: 'Space Grotesk Variable', var(--sl-font);
		--mono: 'IBM Plex Mono', ui-monospace, monospace;
		--bg2: #0e1119;
		--surface: #12151f;
		--line: rgba(160, 174, 208, 0.15);
		--line2: rgba(160, 174, 208, 0.07);
		--text: #9aa3ba;
		--text2: #c9d0e2;
		--head: #f4f6fc;
		--dim: #5d6579;
		--dot: rgba(160, 174, 208, 0.28);
		--chip: rgba(160, 174, 208, 0.09);
		--tile-bg: #141827;
		--glow-op: 0.5;
		--code-bg: #0d1017;
		--code-bar: #11141d;
		--kw: #ff7b72;
		--str: #a5d6ff;
		--fn: #d2a8ff;
		--const: #79c0ff;
		--cm: #6f7890;
		--tag: #7ee787;

		color: var(--text);
		font-size: 1rem;
	}

	:global(:root[data-theme='light']) .landing {
		--bg2: #ffffff;
		--surface: #ffffff;
		--line: rgba(20, 30, 70, 0.14);
		--line2: rgba(20, 30, 70, 0.06);
		--text: #4b5468;
		--text2: #353e55;
		--head: #0d1220;
		--dim: #8a92a6;
		--dot: rgba(20, 30, 70, 0.2);
		--chip: rgba(20, 30, 70, 0.05);
		--tile-bg: #ffffff;
		--glow-op: 0.28;
		--code-bg: #f4f6fb;
		--code-bar: #eceff7;
		--kw: #cf222e;
		--str: #0a3069;
		--fn: #8250df;
		--const: #0550ae;
		--cm: #6e7781;
		--tag: #116329;
	}

	/* Break out of Starlight's narrow markdown column */
	.landing {
		width: 100%;
	}
	.landing :global(a) {
		color: var(--link);
		text-decoration: none;
	}
	.landing :global(a:hover) {
		color: var(--head);
	}

	/* ---- Hero ---- */
	.hero {
		position: relative;
		overflow: hidden;
		border-bottom: 1px solid var(--line2);
	}
	.dots {
		position: absolute;
		inset: 0;
		background-image: radial-gradient(circle, var(--dot) 1px, transparent 1px);
		background-size: 26px 26px;
		/* Full-width vertical fade — reaches both edges, no rounded corner artifact */
		-webkit-mask-image: linear-gradient(to bottom, black 0%, black 42%, transparent 88%);
		mask-image: linear-gradient(to bottom, black 0%, black 42%, transparent 88%);
		pointer-events: none;
	}
	.glow {
		position: absolute;
		opacity: var(--glow-op);
		pointer-events: none;
	}
	.glow1 {
		top: -14rem;
		left: 50%;
		transform: translateX(-50%);
		width: 52rem;
		height: 26rem;
		background: radial-gradient(ellipse at center, color-mix(in srgb, var(--ac1) 40%, transparent), transparent 65%);
	}
	.glow2 {
		top: -8rem;
		left: 62%;
		width: 30rem;
		height: 20rem;
		background: radial-gradient(ellipse at center, color-mix(in srgb, var(--ac2) 35%, transparent), transparent 65%);
	}

	.tiles {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}
	.tile {
		position: absolute;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 0.875rem;
		border: 1px solid var(--line);
		background: var(--tile-bg);
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
		color: var(--text2);
		opacity: 0.7;
		animation: float var(--dur, 8s) ease-in-out var(--delay, 0s) infinite;
	}
	.tile.accent {
		color: var(--link);
		opacity: 1;
	}
	.tile.dim {
		opacity: 0.68;
	}
	.tile-grad {
		background: linear-gradient(135deg, var(--ac1), var(--ac2));
		border-color: transparent;
		color: #fff;
		box-shadow: 0 8px 24px color-mix(in srgb, var(--ac1) 40%, transparent);
		opacity: 0.9;
	}
	.tile-grad2 {
		background: linear-gradient(135deg, var(--ac2), var(--ac1));
		border-color: transparent;
		color: #fff;
		box-shadow: 0 8px 24px color-mix(in srgb, var(--ac2) 40%, transparent);
		opacity: 0.85;
	}
	/* Desktop floats live in the side gutters. Below 78rem those gutters
	   collapse, so hide them and float a smaller set in the top/bottom bands. */
	.tiles-mobile {
		position: absolute;
		inset: 0;
		pointer-events: none;
		display: none;
	}
	@media (max-width: 78rem) {
		.tiles {
			display: none;
		}
		.tiles-mobile {
			display: block;
		}
	}

	.hero-copy {
		position: relative;
		max-width: 54rem;
		margin: 0 auto;
		padding: clamp(4rem, 10vh, 7rem) 1.5rem clamp(3rem, 7vh, 5rem);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.75rem;
		text-align: center;
	}
	.eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--mono);
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--link);
		border: 1px solid color-mix(in srgb, var(--ac1) 35%, var(--line));
		background: color-mix(in srgb, var(--ac1) 8%, transparent);
		border-radius: 9999px;
		padding: 0.375rem 0.875rem;
		animation: fade 0.5s ease both;
	}
	.eyebrow-dot {
		width: 0.375rem;
		height: 0.375rem;
		border-radius: 9999px;
		background: linear-gradient(135deg, var(--ac1), var(--ac2));
	}
	.hero-copy h1 {
		font-family: var(--disp);
		font-size: clamp(2.75rem, 7vw, 4.75rem);
		font-weight: 700;
		color: var(--head);
		line-height: 1.04;
		letter-spacing: -0.03em;
		max-width: 16em;
		margin: 0;
		animation: fade 0.5s ease 0.06s both;
	}
	.grad-text {
		background: linear-gradient(90deg, var(--ac1), var(--ac2));
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
		color: var(--ac1); /* fallback if background-clip:text unsupported */
	}
	.lead {
		font-size: 1.1875rem;
		line-height: 1.65;
		max-width: 36rem;
		color: var(--text);
		margin: 0;
		animation: fade 0.5s ease 0.12s both;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.875rem;
		justify-content: center;
		align-items: center;
		animation: fade 0.5s ease 0.18s both;
	}
	.cta {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		background: linear-gradient(135deg, var(--ac1), var(--ac2));
		color: #fff !important;
		font-family: var(--disp);
		font-weight: 600;
		font-size: 0.9375rem;
		padding: 0.75rem 1.375rem;
		border-radius: 0.75rem;
		box-shadow: 0 4px 24px color-mix(in srgb, var(--ac1) 45%, transparent);
		transition: transform 0.15s, box-shadow 0.15s;
	}
	.cta:hover {
		transform: translateY(-2px);
		box-shadow: 0 8px 32px color-mix(in srgb, var(--ac1) 60%, transparent);
	}
	.copy-btn {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 0.625rem;
		font-family: var(--mono);
		font-size: 0.875rem;
		color: var(--text2);
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: 0.75rem;
		padding: 0.75rem 1.125rem;
		cursor: pointer;
		transition: border-color 0.15s;
	}
	.copy-btn:hover {
		border-color: color-mix(in srgb, var(--ac1) 50%, var(--line));
	}
	.copy-btn .prompt {
		color: var(--dim);
		user-select: none;
	}
	.copy-btn :global([data-icon='lucide:copy']) {
		color: var(--dim);
	}
	.stats {
		display: grid;
		grid-template-columns: repeat(4, auto);
		gap: 1.25rem 2.5rem;
		justify-content: center;
		margin-top: 1.25rem;
		animation: fade 0.5s ease 0.24s both;
	}
	.stat {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 0.125rem;
		margin-top: 1rem;
	}
	.stat-n {
		font-family: var(--disp);
		font-size: 1.5rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		background: linear-gradient(90deg, var(--ac1), var(--ac2));
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
		color: var(--ac1); /* fallback */
	}
	.stat-l {
		font-size: 0.8125rem;
		color: var(--dim);
	}

	/* ---- Section blocks ---- */
	.block {
		max-width: 66rem;
		margin: 0 auto;
	}
	.features {
		padding: 4rem 1.5rem 3rem;
	}
	.block-head {
		display: flex;
		flex-direction: column;
		gap: 0.625rem;
		margin-bottom: 2.25rem;
	}
	.kicker {
		font-family: var(--mono);
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--link);
	}
	.landing h2 {
		font-family: var(--disp);
		font-size: clamp(1.75rem, 3.5vw, 2.375rem);
		font-weight: 700;
		color: var(--head);
		letter-spacing: -0.02em;
		line-height: 1.15;
		margin: 0;
	}
	.block-head p,
	.teaser-copy p {
		max-width: 40rem;
		color: var(--text);
		line-height: 1.7;
		margin: 0;
	}

	.feature-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
		gap: 1rem;
	}

	.card {
		position: relative;
		border: 1px solid var(--line);
		border-radius: 1rem;
		background: var(--surface);
		padding: 1.375rem;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		transition: transform 0.18s, border-color 0.18s, box-shadow 0.18s;
	}
	.card:hover {
		transform: translateY(-3px);
		border-color: color-mix(in srgb, var(--ac1) 45%, var(--line));
		box-shadow: 0 12px 32px rgba(0, 0, 0, 0.16), 0 0 0 1px color-mix(in srgb, var(--ac1) 18%, transparent);
	}
	.card-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 0.75rem;
		background: color-mix(in srgb, var(--ac1) 11%, transparent);
		color: var(--link);
	}
	.card-title {
		font-family: var(--disp);
		font-size: 1.0625rem;
		font-weight: 600;
		color: var(--head);
		line-height: 1.3;
		margin: 0;
	}
	.card-desc {
		font-size: 0.875rem;
		line-height: 1.65;
		color: var(--text);
		margin: 0;
	}

	/* ---- Code teaser ---- */
	.teaser {
		padding: 2rem 1.5rem 5rem;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
		gap: 2.5rem;
		align-items: center;
	}
	.teaser-copy {
		display: flex;
		flex-direction: column;
		gap: 0.625rem;
	}
	.teaser-copy :global(code) {
		background: var(--chip);
		border: 1px solid var(--line2);
		padding: 0.125rem 0.375rem;
		border-radius: 0.375rem;
		font-size: 0.8125em;
		font-family: var(--mono);
	}
	.teaser-links {
		display: flex;
		gap: 1rem;
		margin-top: 0.5rem;
	}
	.teaser-links a {
		font-weight: 600;
		font-size: 0.9375rem;
	}
	.code-card {
		position: relative;
		margin: 0;
		border: 1px solid var(--line);
		border-radius: 1rem;
		background: var(--code-bg);
		overflow: hidden;
		box-shadow: 0 24px 64px rgba(0, 0, 0, 0.24);
	}
	.code-card figcaption {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		background: var(--code-bar);
		border-bottom: 1px solid var(--line2);
		padding: 0.625rem 1rem;
	}
	.tl {
		width: 0.625rem;
		height: 0.625rem;
		border-radius: 9999px;
	}
	.tl-r { background: #ff5f57; }
	.tl-y { background: #febc2e; }
	.tl-g { background: #28c840; }
	.filename {
		margin-left: 0.5rem;
		font-family: var(--mono);
		font-size: 0.75rem;
		color: var(--dim);
	}
	.code-card pre {
		margin: 0;
		padding: 1.125rem 1.25rem;
		overflow-x: auto;
		font-family: var(--mono);
		font-size: 0.8125rem;
		line-height: 1.8;
		color: var(--text2);
	}
	.code-card .kw { color: var(--kw); }
	.code-card .str { color: var(--str); }
	.code-card .fn { color: var(--fn); }
	.code-card .const { color: var(--const); }
	.code-card .cm { color: var(--cm); }
	.code-card .tag { color: var(--tag); }

	/* Copy button: focus ring + "Copied!" state */
	.copy-btn:focus-visible,
	.cta:focus-visible {
		outline: 2px solid var(--ac1);
		outline-offset: 3px;
	}
	/* Copied state: keep the command visible, just swap the copy icon → check */
	.copy-btn[data-copied='true'] {
		border-color: color-mix(in srgb, var(--ac1) 60%, var(--line));
	}
	/* Copy + check share one grid cell and cross-fade via opacity — exactly one is
	   visible, both stay in the same slot, so there's no layout shift and no flash.
	   `margin: 0` neutralizes Starlight's markdown flow-spacing, which adds
	   margin-top:1rem to the 2nd sibling (the check icon) and otherwise shoved it
	   ~16px down the moment it appeared. */
	.copy-swap {
		display: grid;
		flex-shrink: 0;
		place-items: center;
	}
	.copy-swap :global([data-icon]) {
		grid-area: 1 / 1;
		margin: 0;
		transition: opacity 0.15s ease;
	}
	.copy-swap :global([data-icon='lucide:check']) {
		opacity: 0;
		color: var(--ac1);
	}
	.copy-btn[data-copied='true'] .copy-swap :global([data-icon='lucide:copy']) {
		opacity: 0;
	}
	.copy-btn[data-copied='true'] .copy-swap :global([data-icon='lucide:check']) {
		opacity: 1;
	}

	/* "Copied!" ticker — a small pill that drops in below the button on success and
	   fades out with the `data-copied` state. On desktop the click handler repositions
	   it under the cursor (inline left/top override the defaults below); on touch /
	   keyboard it stays centered under the button. Accent gradient works in both themes
	   (--ac1/--ac2 are theme-independent). */
	.copied-toast {
		position: absolute;
		z-index: 5; /* stay above the stats row that follows in the DOM */
		left: 50%;
		top: calc(100% + 0.5rem);
		transform: translate(-50%, -0.35rem);
		padding: 0.25rem 0.5rem;
		border-radius: 0.5rem;
		font-family: var(--disp);
		font-size: 0.75rem;
		font-weight: 700;
		line-height: 1;
		letter-spacing: 0.01em;
		white-space: nowrap;
		color: #06240f;
		background: linear-gradient(135deg, var(--ac1), var(--ac2));
		box-shadow: 0 6px 18px color-mix(in srgb, var(--ac1) 40%, transparent);
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.18s ease, transform 0.18s ease;
	}
	.copied-toast::after {
		content: '';
		position: absolute;
		bottom: 100%;
		left: 50%;
		transform: translateX(-50%);
		border: 5px solid transparent;
		border-bottom-color: var(--ac1);
	}
	.copy-btn[data-copied='true'] .copied-toast {
		opacity: 1;
		transform: translate(-50%, 0);
	}

	/* ---- Responsive ---- */
	@media (max-width: 48rem) {
		.hero-copy {
			padding-top: clamp(2.5rem, 8vh, 4rem);
			gap: 1.375rem;
		}
		.stats {
			gap: 1.25rem 2rem;
			margin-top: 0.75rem;
		}
	}
	@media (max-width: 34rem) {
		.stats {
			grid-template-columns: repeat(2, auto);
			gap: 1.25rem 2rem;
		}
	}
	@media (max-width: 30rem) {
		.actions {
			flex-direction: column;
			align-items: stretch;
			width: 100%;
			max-width: 20rem;
		}
		.cta,
		.copy-btn {
			justify-content: center;
		}
		.copy-btn {
			font-size: 0.8125rem;
		}
		.teaser-links {
			flex-direction: column;
			gap: 0.5rem;
		}
	}

	@keyframes float {
		0%, 100% { transform: translateY(0) rotate(var(--rot, 0deg)); }
		50% { transform: translateY(-10px) rotate(var(--rot, 0deg)); }
	}
	@keyframes fade {
		from { opacity: 0; transform: translateY(8px); }
		to { opacity: 1; transform: translateY(0); }
	}
	@media (prefers-reduced-motion: reduce) {
		.tile,
		.eyebrow,
		.hero-copy h1,
		.lead,
		.actions,
		.stats {
			animation: none;
		}
		.copy-swap :global([data-icon]) {
			transition: none;
		}
		.copied-toast {
			transition-property: opacity;
			transform: translate(-50%, 0);
		}
	}
</style>

<script>
	function legacyCopy(text: string): boolean {
		const ta = document.createElement('textarea');
		ta.value = text;
		ta.setAttribute('readonly', '');
		ta.style.cssText = 'position:fixed;top:0;left:0;width:1px;height:1px;opacity:0;';
		document.body.appendChild(ta);
		const sel = document.getSelection();
		const saved = sel && sel.rangeCount ? sel.getRangeAt(0) : null;
		ta.select();
		ta.setSelectionRange(0, text.length); // iOS Safari
		let ok = false;
		try {
			ok = document.execCommand('copy');
		} catch {
			ok = false;
		}
		document.body.removeChild(ta);
		if (saved && sel) {
			sel.removeAllRanges();
			sel.addRange(saved);
		}
		return ok;
	}

	// Desktop mice (fine, hovering pointer) drop the ticker just under the cursor;
	// touch and keyboard activation fall back to the centered-under-button default.
	const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
	function placeToast(btn: HTMLElement, e: MouseEvent) {
		const toast = btn.querySelector<HTMLElement>('.copied-toast');
		if (!toast) return;
		// e.detail === 0 => activated via keyboard (Enter/Space), so there's no cursor.
		if (finePointer.matches && e.detail > 0) {
			const r = btn.getBoundingClientRect();
			toast.style.left = e.clientX - r.left + 'px';
			toast.style.top = e.clientY - r.top + 18 + 'px';
		} else {
			toast.style.left = '';
			toast.style.top = '';
		}
	}

	document.querySelectorAll<HTMLElement>('.landing .copy-btn').forEach((btn) => {
		let timer: ReturnType<typeof setTimeout>;
		const restLabel = btn.getAttribute('aria-label') || 'Copy install command';
		btn.addEventListener('click', async (e) => {
			const text = btn.getAttribute('data-copy') || '';
			let ok = false;
			if (navigator.clipboard && window.isSecureContext) {
				try {
					await navigator.clipboard.writeText(text);
					ok = true;
				} catch {
					ok = false;
				}
			}
			if (!ok) ok = legacyCopy(text);
			if (!ok) return; // copy genuinely failed — no false "copied"
			placeToast(btn, e as MouseEvent);
			btn.setAttribute('data-copied', 'true');
			btn.setAttribute('aria-label', 'Copied!'); // announce to screen readers
			clearTimeout(timer);
			timer = setTimeout(() => {
				btn.removeAttribute('data-copied');
				btn.setAttribute('aria-label', restLabel);
			}, 1400);
		});
	});
</script>
