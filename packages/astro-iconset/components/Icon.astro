---
import type { IconifyIcon } from "@iconify/types";
import { getIconData, iconToSVG } from "@iconify/utils";
import type { HTMLAttributes } from "astro/types";
import { createHash } from "node:crypto";
import { cache } from "./cache.js";
import type { IconifyIconBuildResult } from "@iconify/utils/lib/svg/build.js";
import type { AstroIconCollectionMap } from "../typings/integration";

type BaseProps = Omit<HTMLAttributes<"svg">, "name"> & {
  "is:inline"?: boolean;
  title?: string;
  desc?: string;
  size?: number | string;
  width?: number | string;
  height?: number | string;
};

// @ts-ignore generated by typegen
import type { Icon } from "virtual:astro-iconset";

type Props =
  | (BaseProps & { name: Icon; icon?: never })
  | (BaseProps & { icon: IconifyIcon; name?: never });

class AstroIconError extends Error {
  public hint: string = "";

  constructor(message: string) {
    super(message);
  }
}

const props = Astro.props as Props;
const {
  icon,
  name: nameProp,
  title,
  desc,
  "is:inline": inline = false,
  ...rest
} = props;

if (icon && nameProp != null && String(nameProp).length > 0) {
  throw new AstroIconError('Use either "name" or "icon", not both.');
}

if (
  !icon &&
  (nameProp === undefined ||
    (typeof nameProp === "string" && nameProp.length === 0))
) {
  const err = new AstroIconError('Provide "name" or "icon".');
  if (import.meta.env.DEV) {
    err.hint =
      'Example: <Icon name="md:home" /> or import home from "./home.svg?icon" then <Icon icon={home} />.';
  }
  throw err;
}

function importedCacheKey(i: IconifyIcon): string {
  return `import:${createHash("sha256").update(`${i.body ?? ""}:${i.width ?? ""}:${i.height ?? ""}`).digest("hex").slice(0, 24)}`;
}

const cacheKey = icon ? importedCacheKey(icon) : String(nameProp);

const req = Astro.request;
const map = cache.get(req) ?? new Map();
const i = map.get(cacheKey) ?? 0;
map.set(cacheKey, i + 1);
cache.set(req, map);

const includeSymbol = !inline && i === 0;

let normalizedProps: Partial<IconifyIconBuildResult["attributes"]>;
let normalizedBody: string;
let viewBox: string | undefined;
let id: string;

if (icon) {
  const renderData = iconToSVG(icon);
  id = `ai:${importedCacheKey(icon)}`;
  const attrs = rest as Record<string, unknown>;
  if (attrs.size) {
    attrs.width = attrs.size;
    attrs.height = attrs.size;
    delete attrs.size;
  }
  normalizedProps = {
    ...(renderData.attributes as Partial<
      IconifyIconBuildResult["attributes"]
    >),
    ...attrs,
  };
  normalizedBody = renderData.body;
  viewBox = normalizedProps.viewBox as string | undefined;
  if (includeSymbol) {
    delete normalizedProps.viewBox;
  }
} else {
  const mod = (await import("virtual:astro-iconset")) as {
    default: AstroIconCollectionMap;
    config: { include?: Record<string, ["*"] | string[]> };
  };
  const icons = mod.default;
  const config = mod.config;
  const name = nameProp as string;
  const { include = {} } = config;
  const sets = Object.keys(include);

  let [setName, iconName] = name.split(":");

  if (!setName && iconName) {
    const err = new AstroIconError(`Invalid "name" provided!`);
    if (import.meta.env.DEV) {
      err.hint = `The provided value of "${name}" is invalid.\n\nDid you forget the icon set name? If you were attemping to reference a local icon, use the icon's name directly. (ie. "${iconName}")`;
    }
    throw err;
  }

  if (!iconName) {
    iconName = setName;
    setName = "local";

    if (!icons[setName]) {
      const err = new AstroIconError('Unable to load the "local" icon set!');
      if (import.meta.env.DEV) {
        err.hint =
          'It looks like the "local" set was not loaded.\n\nDid you forget to create the icon directory or to update your config?';
      }
      throw err;
    }

    if (!(iconName in icons[setName].icons)) {
      const err = new AstroIconError(`Unable to locate "${name}" icon!`);
      if (import.meta.env.DEV) {
        err.hint = `The icon named "${iconName}" was not found in your local icon directory.\n\nDid you forget to configure your icon directory or make a typo?`;
      }
      throw err;
    }
  }

  const collection = icons[setName];

  if (!collection) {
    const err = new AstroIconError(`Unable to locate the "${setName}" icon set!`);
    if (import.meta.env.DEV) {
      if (sets.includes(setName)) {
        err.hint = `It looks like the "${setName}" set was not loaded.\n\nDid you install the "@iconify-json/${setName}" dependency?`;
      } else {
        err.hint = `It looks like the "${setName}" set is not included in your configuration.\n\nDo you need to add the "${setName}" set?`;
      }
    }
    throw err;
  }

  const iconData = getIconData(collection, iconName ?? setName);
  if (!iconData) {
    const err = new AstroIconError(`Unable to locate "${name}" icon!`);
    if (import.meta.env.DEV) {
      const [maybeStar] = include[setName] ?? [];
      const listed = include[setName] as readonly string[] | undefined;
      if (maybeStar === "*" || listed?.includes(iconName ?? "")) {
        err.hint = `The "${setName}" set does not include an icon named "${iconName}".\n\nIs this a typo?`;
      } else {
        err.hint = `The "${setName}" set is not configured to include an icon named "${iconName}".\n\nDo you need to add it to your configuration?`;
      }
    }
    throw err;
  }

  id = `ai:${collection.prefix}:${iconName ?? setName}`;

  const attrs = rest as Record<string, unknown>;
  if (attrs.size) {
    attrs.width = attrs.size;
    attrs.height = attrs.size;
    delete attrs.size;
  }

  const renderData = iconToSVG(iconData);
  normalizedProps = {
    ...(renderData.attributes as Partial<
      IconifyIconBuildResult["attributes"]
    >),
    ...attrs,
  };
  normalizedBody = renderData.body;
  viewBox = normalizedProps.viewBox as string | undefined;
  if (includeSymbol) {
    delete normalizedProps.viewBox;
  }
}
---

<svg {...normalizedProps} data-icon={cacheKey}>
  {title && <title>{title}</title>}
  {desc && <desc>{desc}</desc>}
  {
    inline ? (
      <Fragment id={id} set:html={normalizedBody} />
    ) : (
      <Fragment>
        {includeSymbol && <symbol id={id} viewBox={viewBox} set:html={normalizedBody} />}
        <use href={`#${id}`} />
      </Fragment>
    )
  }
</svg>
